# ============================================================================
# Antigravity4Lark - Environment Configuration
# Copy to `.env` before starting:
#   cp .env.example .env
# ============================================================================

# [Required] 你的个人飞书 open_id（如 ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx）
# 若暂不知道自己的 open_id，可先留空运行 `npm start`，给机器人发一条 `#ag 帮助`，
# 终端日志会打印出你的 open_id。
FEISHU_OPEN_ID=

# [Optional] 若多个本地桥接共享同一个飞书机器人，可指定另一份包含 FEISHU_OPEN_ID 的 .env 路径作为只读回退
# FEISHU_OPEN_ID_FALLBACK_ENV=../other-bridge/.env

# [Optional] lark-cli 可执行文件路径（默认自动查找 ~/.local/bin/lark-cli 或 PATH）
LARK_CLI=lark-cli

# [Optional] 本桥状态与日志目录（默认 ~/.antigravity-feishu）
AG_STATE_DIR=

# [Optional] Antigravity 本地数据目录（默认 ~/.gemini/antigravity）
AG_DATA_DIR=

# [Optional] agentapi 可执行文件路径（默认 ~/.gemini/antigravity/bin/agentapi）
AG_AGENTAPI_BIN=

# [Optional] 新建会话时的默认工作目录（默认当前仓库目录）
AG_WORKDIR=

# [Optional] 锁定某个会话 UUID 作为默认总控中心；也可直接在飞书发送 `#ag 默认 <编号>` 动态切换
AG_DEFAULT_CONVERSATION_ID=

# [Optional] 主动回推范围：
#   all   = 推送全部 Antigravity 顶层桌面会话的回复、提问与致命异常（默认）
#   bound = 仅推送默认总控会话及从飞书新建/发过消息绑定的会话
#   off   = 暂停主动回推（仍可响应主动发消息与 `#ag 读`）
AG_PUSH_MODE=all

# [Optional] 后台巡检间隔毫秒数（默认 2000）
AG_POLL_INTERVAL_MS=2000

# [Optional] 单条飞书回推最大字符数（默认 4000，超出将自动分段发送）
AG_MAX_PUSH_LENGTH=4000

# [Optional] Electron CDP 调试端口端点（默认 http://127.0.0.1:9223，避开 Cursor 的 9222）
# 运行 ./start-antigravity.sh（或在飞书发送 `#ag 重启cdp`）开启 9223 后，即可支持飞书远程发消息、
# 跨工作区调度、点击停止与审批按钮。
AG_CDP_URL=http://127.0.0.1:9223
